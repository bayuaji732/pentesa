# ==============================================================================
# PENTESA CONFIGURATION TEMPLATE
# ==============================================================================

# Application Environment
PENTESA_ENV=development
PENTESA_DEBUG=true
PENTESA_LOG_LEVEL=INFO

# Security & Cryptography
# Generate with: openssl rand -hex 32
PENTESA_SECRET_KEY=change-this-in-production-0123456789abcdef0123456789abcdef
PENTESA_MASTER_KEY=change-this-in-production-master-key-32-chars-long-1234
PENTESA_ACCESS_TOKEN_EXPIRE_MINUTES=60
PENTESA_REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (PostgreSQL 16 in production, SQLite for local dev/testing)
DATABASE_URL=sqlite+aiosqlite:///./pentesa.db
# Production PostgreSQL URL:
# DATABASE_URL=postgresql+asyncpg://pentesa_user:pentesa_password@localhost:5432/pentesa

# Redis Cache & Message Broker
REDIS_URL=redis://localhost:6379/0

# Outbound Egress Proxy (Layer 2 Scope Enforcement)
EGRESS_PROXY_HOST=127.0.0.1
EGRESS_PROXY_PORT=8080

# Out-of-Band Callback Sink (OAST)
CALLBACK_SINK_HOST=127.0.0.1
CALLBACK_SINK_HTTP_PORT=8888
CALLBACK_SINK_DNS_PORT=8053

# Rate Limiting & Safety Guardrails
DEFAULT_MAX_RPS=50
MAX_FUZZ_REQUESTS_WITHOUT_APPROVAL=5000
MAX_AUTH_ATTEMPTS_WITHOUT_APPROVAL=15

# ==============================================================================
# LLM PROVIDER CONFIGURATION
# ==============================================================================
# Provider selection: 'mock' (default offline), 'litellm', 'ollama', 'openai'
PENTESA_LLM_PROVIDER=litellm

# LiteLLM Proxy Gateway (Local Proxy, Docker, or Central Server)
# Base URL: LiteLLM endpoint (e.g. http://localhost:4000 or http://localhost:4000/v1)
PENTESA_LITELLM_BASE_URL=http://localhost:4000
# API Key: LiteLLM master key or user virtual token
PENTESA_LITELLM_API_KEY=sk-litellm-proxy-master-key
# Model: Routed model alias or path (e.g. gpt-4o, claude-3-5-sonnet, gemini/gemini-1.5-pro, ollama/llama3.1)
PENTESA_LITELLM_MODEL=gpt-4o
# Request timeout in seconds
PENTESA_LITELLM_TIMEOUT=120.0

# Local Ollama Configuration (if using ollama directly)
# PENTESA_OLLAMA_BASE_URL=http://localhost:11434
# PENTESA_OLLAMA_MODEL=llama3.1

# Direct OpenAI Configuration (if using OpenAI API directly)
# PENTESA_OPENAI_BASE_URL=https://api.openai.com/v1
# PENTESA_OPENAI_API_KEY=sk-openai-api-key
# PENTESA_OPENAI_MODEL=gpt-4o-mini


