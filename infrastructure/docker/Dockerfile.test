# Pentesa Automated Test Suite Container (Linux x86_64)
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH="/app" \
    PENTESA_ENV="test" \
    PENTESA_LLM_PROVIDER="mock" \
    FFUF_VERSION="2.1.0" \
    FFUF_SHA256="fc2c82736c14dcbea4daf3d3cf3878c1c4773008ba45c2bc0fceba7d17b40bb5" \
    NUCLEI_VERSION="3.3.7" \
    NUCLEI_SHA256="725ef892fcffd1b03ad4f0874942fc4b623c0419b6b6c6c91fe4a5a65671f77c" \
    NUCLEI_TEMPLATES_TAG="v10.5.2" \
    NUCLEI_TEMPLATES_SHA256="24551e1ef6a5f99f6a0a3cb98abc4325a1e554367d2a8ce09caaf82d860cd50b" \
    SECLISTS_COMMIT="8115582"

WORKDIR /app

# Install system dependencies and pinned security tools (nuclei & ffuf) with SHA-256 verification
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    ca-certificates \
    libpq-dev \
    git \
    dnsutils \
    iputils-ping \
    unzip \
    tar \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL -o /tmp/ffuf.tar.gz "https://github.com/ffuf/ffuf/releases/download/v${FFUF_VERSION}/ffuf_${FFUF_VERSION}_linux_amd64.tar.gz" \
    && echo "${FFUF_SHA256}  /tmp/ffuf.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/ffuf.tar.gz -C /usr/local/bin ffuf \
    && chmod 755 /usr/local/bin/ffuf \
    && rm -f /tmp/ffuf.tar.gz \
    && curl -fsSL -o /tmp/nuclei.zip "https://github.com/projectdiscovery/nuclei/releases/download/v${NUCLEI_VERSION}/nuclei_${NUCLEI_VERSION}_linux_amd64.zip" \
    && echo "${NUCLEI_SHA256}  /tmp/nuclei.zip" | sha256sum -c - \
    && unzip /tmp/nuclei.zip nuclei -d /usr/local/bin \
    && chmod 755 /usr/local/bin/nuclei \
    && rm -f /tmp/nuclei.zip

# Install uv for fast dependency installation
COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

# Copy requirements and install
COPY requirements.txt .
RUN uv pip install --system -r requirements.txt

# Copy source trees and test suite
COPY packages/ ./packages/
COPY database/ ./database/
COPY services/ ./services/
COPY agents/ ./agents/
COPY integrations/ ./integrations/
COPY apps/ ./apps/
COPY scripts/ ./scripts/
COPY tests/ ./tests/
COPY pyproject.toml .

# Bake pinned Nuclei templates and ffuf wordlists (TOOL-ASSETS-01)
RUN mkdir -p /opt/nuclei-templates /opt/wordlists && \
    cp -r integrations/nuclei/templates/* /opt/nuclei-templates/ && \
    cp integrations/ffuf/wordlists/common_paths.txt /opt/wordlists/common_paths.txt && \
    chmod -R 755 /opt/nuclei-templates /opt/wordlists

# Startup check verifying pinned security tools and assets
RUN python scripts/check_security_tools.py

# Create unprivileged test user
RUN mkdir -p /app/data && \
    useradd -m -u 10001 pentesa && \
    chown -R pentesa:pentesa /app
USER pentesa

CMD ["pytest", "tests/", "-v", "--tb=short"]
