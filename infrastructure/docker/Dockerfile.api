# Pentesa Core API Server Dockerfile
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH="/app"

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    ca-certificates \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install uv for fast dependency resolution
COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

# Copy requirements and install dependencies
COPY requirements.txt .
RUN uv pip install --system -r requirements.txt

# Copy source trees
COPY packages/ ./packages/
COPY database/ ./database/
COPY services/ ./services/
COPY agents/ ./agents/
COPY integrations/ ./integrations/
COPY apps/api/ ./apps/api/
COPY scripts/ ./scripts/

# Create persistent storage mount points and unprivileged service user
RUN mkdir -p /app/data/reports /app/data/evidence && \
    useradd -m -u 10001 pentesa && \
    chown -R pentesa:pentesa /app
USER pentesa

EXPOSE 8000

CMD ["uvicorn", "apps.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
