# ==============================================================================
# PENTESA CONFIGURATION TEMPLATE
# ==============================================================================

# Application Environment
PENTESA_ENV=development
PENTESA_DEBUG=true
PENTESA_LOG_LEVEL=INFO

# Security & Cryptography
# Generate with: openssl rand -hex 32
PENTESA_SECRET_KEY=change-this-in-production-0123456789abcdef0123456789abcdef
PENTESA_MASTER_KEY=change-this-in-production-master-key-32-chars-long-1234
PENTESA_ACCESS_TOKEN_EXPIRE_MINUTES=60
PENTESA_REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (PostgreSQL 16 in production, SQLite for local dev/testing)
DATABASE_URL=sqlite+aiosqlite:///./pentesa.db
# Production PostgreSQL URL:
# DATABASE_URL=postgresql+asyncpg://pentesa_user:pentesa_password@localhost:5432/pentesa

# Redis Cache & Message Broker
REDIS_URL=redis://localhost:6379/0

# Outbound Egress Proxy (Layer 2 Scope Enforcement)
EGRESS_PROXY_HOST=127.0.0.1
EGRESS_PROXY_PORT=8080

# Out-of-Band Callback Sink (OAST)
CALLBACK_SINK_HOST=127.0.0.1
CALLBACK_SINK_HTTP_PORT=8888
CALLBACK_SINK_DNS_PORT=8053

# Rate Limiting & Safety Guardrails
DEFAULT_MAX_RPS=50
MAX_FUZZ_REQUESTS_WITHOUT_APPROVAL=5000
MAX_AUTH_ATTEMPTS_WITHOUT_APPROVAL=15

