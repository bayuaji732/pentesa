# ==============================================================================
# PENTESA PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE (.env.production.example)
# Copy this file to .env.production and provide production credentials.
# WARNING: .env.production is gitignored and MUST NEVER be committed to version control.
# ==============================================================================

# Application Environment Mode
PENTESA_ENV=production
PENTESA_DEBUG=false
PENTESA_LOG_LEVEL=INFO

# Security & Cryptography (Generate with: openssl rand -hex 32)
# Must be at least 32 characters / 256-bit entropy
PENTESA_SECRET_KEY=<REQUIRED_GENERATE_32B_JWT_SECRET_KEY>
PENTESA_ENCRYPTION_KEY=<REQUIRED_GENERATE_32B_AES_GCM_MASTER_KEY>
PENTESA_ACCESS_TOKEN_EXPIRE_MINUTES=60
PENTESA_REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial Bootstrap Administrator Account (Created idempotently on startup)
PENTESA_BOOTSTRAP_ADMIN=true
PENTESA_BOOTSTRAP_ADMIN_EMAIL=security-lead@example.com
PENTESA_BOOTSTRAP_ADMIN_PASSWORD=<REQUIRED_STRONG_COMPLEX_PASSWORD_12+_CHARS>

# PostgreSQL 16 Credentials (Database container & application connection)
POSTGRES_USER=pentesa_user
POSTGRES_PASSWORD=<REQUIRED_STRONG_NON_DEFAULT_DB_PASSWORD>
POSTGRES_DB=pentesa
PENTESA_DATABASE_URL=postgresql+asyncpg://pentesa_user:${POSTGRES_PASSWORD}@db:5432/pentesa

# Redis Cache & Task Broker
PENTESA_REDIS_URL=redis://redis:6379/0

# Storage Mount Directories
PENTESA_REPORT_STORAGE_DIR=/app/data/reports
PENTESA_EVIDENCE_STORAGE_DIR=/app/data/evidence

# Outbound Egress Proxy (Layer 2 Scope Enforcement)
PENTESA_EGRESS_PROXY_HOST=127.0.0.1
PENTESA_EGRESS_PROXY_PORT=8080
PENTESA_CALLBACK_SINK_HOST=127.0.0.1
PENTESA_CALLBACK_SINK_HTTP_PORT=8888
PENTESA_CALLBACK_SINK_DNS_PORT=8053

# Rate Limiting & Safety Guardrails
PENTESA_DEFAULT_MAX_RPS=50
PENTESA_MAX_FUZZ_REQUESTS_WITHOUT_APPROVAL=5000
PENTESA_MAX_AUTH_ATTEMPTS_WITHOUT_APPROVAL=15
PENTESA_LAYER2_EGRESS_ENABLED=true

# Next.js Public API Gateway URL (Frontend browser connectivity)
NEXT_PUBLIC_API_URL=http://localhost:8000

# LLM Gateway Configuration
PENTESA_LLM_PROVIDER=litellm
PENTESA_LITELLM_BASE_URL=https://proxy.example.com
PENTESA_LITELLM_API_KEY=<REQUIRED_LITELLM_API_KEY>
PENTESA_LITELLM_MODEL=openai/gpt-4o
PENTESA_LITELLM_TIMEOUT=120.0
