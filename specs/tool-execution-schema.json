{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ToolExecutionResult",
  "description": "Standardized schema for all deterministic security tool executions in Pentesa",
  "type": "object",
  "required": [
    "execution_id",
    "project_id",
    "tool_name",
    "status",
    "target_url",
    "start_time",
    "end_time",
    "exit_code",
    "findings_count"
  ],
  "properties": {
    "execution_id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "tool_name": {
      "type": "string",
      "enum": [
        "nuclei",
        "katana",
        "subfinder",
        "httpx",
        "ffuf",
        "python_check",
        "ssl_analyzer",
        "header_analyzer"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "SUCCESS",
        "FAILED",
        "TIMEOUT",
        "CANCELLED",
        "SCOPE_REJECTED"
      ]
    },
    "target_url": {
      "type": "string",
      "format": "uri"
    },
    "argv": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "start_time": {
      "type": "string",
      "format": "date-time"
    },
    "end_time": {
      "type": "string",
      "format": "date-time"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "exit_code": {
      "type": "integer"
    },
    "stdout_summary": {
      "type": "string"
    },
    "stderr_summary": {
      "type": "string"
    },
    "findings_count": {
      "type": "integer",
      "minimum": 0
    },
    "raw_artifacts_path": {
      "type": "string"
    },
    "parsed_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["template_or_check_id", "title", "severity", "matched_at"],
        "properties": {
          "template_or_check_id": { "type": "string" },
          "title": { "type": "string" },
          "severity": { "type": "string", "enum": ["Critical", "High", "Medium", "Low", "Info"] },
          "matched_at": { "type": "string" },
          "curl_command": { "type": "string" },
          "raw_request": { "type": "string" },
          "raw_response": { "type": "string" },
          "extracted_results": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}

