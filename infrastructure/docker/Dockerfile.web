# Pentesa Next.js SOC Web Console Dockerfile
FROM node:20-alpine AS deps

WORKDIR /app
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci

FROM node:20-alpine AS builder

WORKDIR /app
ARG NEXT_PUBLIC_API_URL=http://localhost:8000
ARG API_INTERNAL_URL=http://api:8000
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    API_INTERNAL_URL=$API_INTERNAL_URL \
    NEXT_TELEMETRY_DISABLED=1

COPY --from=deps /app/node_modules ./node_modules
COPY apps/web/ .
RUN npm run build

FROM node:20-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    NEXT_TELEMETRY_DISABLED=1 \
    API_INTERNAL_URL=http://api:8000

RUN addgroup -g 10001 -S pentesa && adduser -S -u 10001 -G pentesa pentesa

COPY --from=builder --chown=pentesa:pentesa /app/package.json ./package.json
COPY --from=builder --chown=pentesa:pentesa /app/package-lock.json ./package-lock.json
COPY --from=builder --chown=pentesa:pentesa /app/next.config.mjs ./next.config.mjs
COPY --from=builder --chown=pentesa:pentesa /app/node_modules ./node_modules
COPY --from=builder --chown=pentesa:pentesa /app/.next ./.next

USER pentesa

EXPOSE 3000

CMD ["npm", "run", "start"]

